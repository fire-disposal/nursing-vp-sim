# ========================================
# 本地开发环境变量 (.env.example)
# 复制为 .env 并填入实际值
# ========================================

# ── 必填 ────────────────────────────────
ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vptest
TEST_DB_URL=postgresql://postgres:postgres@localhost:5432/nursing_test
SECRET_KEY=change-me-to-a-random-secret-key
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-v4-flash        # 默认通配模型
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # 评分专用模型
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ── 开发环境（本地）──────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost
# ── 生产/Staging 部署时务必改为实际域名 ───
# CORS_ORIGINS=https://nursing.example.com

# ── 微信小程序（可选，不配则禁用微信登录）───
# WECHAT_APPID=wx0000000000000000
# WECHAT_SECRET=00000000000000000000000000000000

# ── 种子数据管理员凭证（空库时自动创建）───
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123


# ── Docker 部署 ──────────────────────────
POSTGRES_PASSWORD=postgres


# ── 可选调参（均有良好默认值）──────────────
# LLM_CONCURRENT_LIMIT=50
# LLM_MAX_RETRIES=3
# ACCESS_TOKEN_EXPIRE_MINUTES=480
