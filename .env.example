# =============================================
#  环境变量配置模板 (.env.example)
#  复制为 .env 并填入实际值
#  ┃ 标记 = 为必须项，其余均有默认值可省略
# =============================================

# ╔═══════════════════════════════════════════╗
# ║  必须配置 — 不设则无法启动                ║
# ╚═══════════════════════════════════════════╝

ENV=development
# 可选: development / staging / production

DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/vptest
# 主数据库连接串（替换 <your-password> 为实际密码）

TEST_DB_URL=postgresql://postgres:<your-password>@localhost:5432/nursing_test
# 测试专用数据库（替换 <your-password> 为实际密码）

JWT_SECRET_KEY=
# JWT 签名密钥，至少 32 字符
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"

FERNET_KEY=
# Fernet 对称加密密钥（用于数据库内 API 密钥加密存储）
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 诊断端点访问令牌（可选）
# 设置后可通过 /api/diagnose?token=<值> 查询系统诊断和错误日志
DIAGNOSE_TOKEN=
# LLM API 密钥（首次启动时自动写入数据库）

# ╔═══════════════════════════════════════════╗
# ║  种子数据管理员 (空库首次启动时自动创建)   ║
# ╚═══════════════════════════════════════════╝

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=your-admin-password-here
# 首次启动后，修改密码或通过管理面板管理用户

# ╔═══════════════════════════════════════════╗
# ║  CORS 跨域 — 按部署环境修改              ║
# ╚═══════════════════════════════════════════╝

CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost
# 开发: http://localhost:3000,http://localhost:8000
# Staging: https://test.205716.xyz
# 生产: https://your-domain.com

# ╔═══════════════════════════════════════════╗
# ║  Docker 部署必填                         ║
# ╚═══════════════════════════════════════════╝

POSTGRES_PASSWORD=<your-strong-password>
# Docker Compose 中 PostgreSQL 实例的密码（必须修改）

# ╔═══════════════════════════════════════════╗
# ║  可选: 监控告警 SMTP (部署时配置)          ║
# ║  不配则监控脚本跳过邮件发送                ║
# ╚═══════════════════════════════════════════╝

# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your-email@qq.com
# SMTP_PASS=your-authorization-code
# MAIL_FROM=your-email@qq.com
# MAIL_TO=your-email@qq.com

# ╔═══════════════════════════════════════════╗
# ║  可选: LLM Provider                      ║
# ║  各用途 model/temperature/max_tokens 等   ║
# ║  统一在 backend/core/llm_profile.py 管理  ║
# ╚═══════════════════════════════════════════╝

# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ╔═══════════════════════════════════════════╗
# ║  可选: 微信小程序登录                    ║
# ║  不配则禁用微信登录                      ║
# ╚═══════════════════════════════════════════╝

# WECHAT_APPID=wx0000000000000000
# WECHAT_SECRET=your-wechat-secret

# ╔═══════════════════════════════════════════╗
# ║  可选: 飞书测试核对单 (CI 使用)           ║
# ║  在 GitHub vars/secrets 中配置            ║
# ║  staging 部署成功后自动追加到多维表格      ║
# ╚═══════════════════════════════════════════╝

# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx          # GitHub vars
# FEISHU_APP_SECRET=                          # GitHub secrets
# FEISHU_SHEET_TOKEN=shtcnxxxxxxxxxxxxxxxx    # GitHub vars, 持久表格
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxx          # GitHub vars, 可选

# ╔═══════════════════════════════════════════╗
# ║  可选: LLM 调用参数                      ║
# ║  并发/超时/重试按用途在 llm_profile.py 定 ║
# ╚═══════════════════════════════════════════╝

# LLM_CONNECTION_POOL_SIZE=60                # HTTP 连接池大小
# LLM_CONNECTION_KEEPALIVE=30                # HTTP 连接保持时间(秒)
# LLM_WORKER_COUNT=1                         # 信号量分割系数(多进程部署=进程数, 默认单进程=1)

# LLM_PRICE_INPUT_PER_1M=1                   # 输入 token 单价 (元/百万, 全局回退; 优先用每 key DB 定价)
# LLM_PRICE_OUTPUT_PER_1M=2                  # 输出 token 单价 (元/百万)
# LLM_COST_CURRENCY=CNY                      # 计价货币
# ASR_COST_PER_SECOND=0.0018                 # 语音识别每秒计费 (元/秒)

# LLM_LOG_OVERFLOW_DIR=/app/data/llm_logs    # LLM 日志溢出写盘路径
# LLM_LOG_OVERFLOW_MAX_SIZE_MB=10            # 日志文件上限(MB)
# LLM_LOG_OVERFLOW_MAX_FILES=5               # 保留日志文件数

# ╔═══════════════════════════════════════════╗
# ║  可选: 评分与结算                        ║
# ╚═══════════════════════════════════════════╝

# SCORING_TIMEOUT_SECONDS=180                # 评分整体超时 (秒)
# SCORING_WORKERS=8                          # 评分后台 worker 数 (上限 10, 受 LLM 信号量约束)
# QUEUE_ENQUEUE_TIMEOUT=10                   # 任务入队超时 (秒)
# REQUEST_TIMEOUT_SECONDS=300                # HTTP 请求整体超时 (秒)
# CLEANUP_INTERVAL_SECONDS=30                # 结算/清理循环间隔 (秒)
# AUTO_SCORE_COVERED_INQUIRIES_MIN=5         # 触发评分的最低采集点数量
# AUTO_SCORE_STUDENT_CHARS_MIN=200           # 触发评分的最低学生字数
# AUTO_SCORE_AI_CHARS_MIN=500                # 触发评分的最低 AI 回复字数

# ╔═══════════════════════════════════════════╗
# ║  可选: 安全与杂项                        ║
# ╚═══════════════════════════════════════════╝

# ACCESS_TOKEN_EXPIRE_MINUTES=10080          # JWT 令牌过期时间 (分钟, 默认7天)
# MAX_REQUEST_BYTES=10485760                 # 请求体上限 (bytes, 默认 10MB)
# BATCH_USER_LIMIT=500                       # 单次批量建用户上限
# MAX_EXPORT_ROWS=20000                      # 单次导出最大行数 (防 DoS)

# ╔═══════════════════════════════════════════╗
# ║  可选: 钉钉部署通知 (GitHub Actions 使用)   ║
# ║  在 GitHub Secrets 中配置 DINGTALK_WEBHOOK  ║
# ║  部署成功后自动向钉钉群播报消息             ║
# ╚═══════════════════════════════════════════╝

# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx  # GitHub Secrets

# ╔═══════════════════════════════════════════╗
# ║  可选: 开发/调试                         ║
# ║  仅本地开发时使用, 生产环境勿设置         ║
# ╚═══════════════════════════════════════════╝

# SKIP_MIGRATION=1                           # 跳过数据库迁移 (使用 create_all)
# APP_VERSION=dev                            # 覆盖版本号
