# ========================================
# 本地开发环境变量 (.env.example)
# 复制为 .env 并填入实际值
# ========================================

# ── 本地开发（必须设置）──────────────────
ENV=development

# 数据库：本地 PostgreSQL 默认端口 5432
DATABASE_URL=postgresql://nursing:nursing123@localhost:5432/nursing_vp

# JWT 密钥：使用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
SECRET_KEY=change-me-to-a-random-secret-key

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# CORS：本地前端开发服务器地址
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost


# ── Docker / 远程部署（CI/CD 自动处理）───
# docker-compose.yml 会覆盖 DATABASE_URL 为容器内地址 (db:5432)
# cd.yml 部署时会自动生成 SECRET_KEY 和 POSTGRES_PASSWORD
# APP_VERSION 由 Docker build arg 注入，无需手动设置

POSTGRES_PASSWORD=nursing123     # docker-compose 引用此变量，本地可不设
ACCESS_TOKEN_EXPIRE_MINUTES=480  # JWT 过期时间（分钟），有默认值


# ── LLM 调参（可选，均有良好默认值）─────
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# LLM_MAX_RETRIES=3
# LLM_REQUEST_TIMEOUT=90
# LLM_CONCURRENT_LIMIT=10
# LLM_CONNECTION_POOL_SIZE=20
# LLM_CONNECTION_KEEPALIVE=10
# LLM_CHAT_TIMEOUT=30
# LLM_CHAT_MAX_TOKENS=512
# LLM_SCORING_TIMEOUT=120
# LLM_SCORING_MAX_TOKENS=2048
# LLM_PRICE_INPUT_PER_1M=0
# LLM_PRICE_OUTPUT_PER_1M=0
# LLM_COST_CURRENCY=CNY
