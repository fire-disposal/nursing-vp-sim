#!/bin/sh
# Pre-commit: format + lint + type check + migration sanity
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Frontend checks
cd "$ROOT/frontend" || exit 1
pnpm exec lint-staged
pnpm tsc --noEmit

# Backend checks — only if Python files are staged
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- "$ROOT/backend/**/*.py" "$ROOT/backend/*.py" 2>/dev/null || true)
if [ -n "$STAGED_PY" ]; then
  echo ""
  echo "  ruff format + check + ty (backend)"
  cd "$ROOT/backend" || exit 1
  STAGED_PY_REL=$(echo "$STAGED_PY" | sed 's|^backend/||')
  uv run ruff format --check $STAGED_PY_REL 2>&1 | tail -3
  uv run ruff check $STAGED_PY_REL 2>&1 | tail -3
  uv run ty $STAGED_PY_REL 2>&1 | tail -3
fi

# Alembic heads check + autogenerate enforcement — if migration files are staged
STAGED_MIG=$(git diff --cached --name-only -- "$ROOT/backend/migrations/versions/**/*.py" 2>/dev/null || true)
if [ -n "$STAGED_MIG" ]; then
  cd "$ROOT/backend" || exit 1
  HEADS=$(uv run alembic heads 2>&1)
  HEAD_COUNT=$(echo "$HEADS" | wc -l)
  if [ "$HEAD_COUNT" -gt 1 ]; then
    echo ""
    echo "  FAIL: alembic has $HEAD_COUNT heads (must be 1)"
    echo "$HEADS"
    exit 1
  fi
  echo "  ok  alembic head: $(echo "$HEADS" | head -1)"

  cd "$ROOT" || exit 1
  node .husky/_/check-migration-autogen.js
fi
