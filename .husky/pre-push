#!/bin/sh
# Pre-push: type check + migration conflict detection + tag validation
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

say()  { echo "${CYAN}$1${NC}"; }
ok()   { echo "  ${GREEN}ok${NC}  $1"; }
fail() { echo "  ${RED}FAIL${NC} $1"; PASS=1; }

# ═══ Migration roundtrip test ═══
HAS_ALEMBIC=false
if [ -f "$ROOT/backend/alembic.ini" ]; then
  MIGRATION_DIR="$ROOT/backend"
  if [ -f "$MIGRATION_DIR/.venv/bin/alembic" ]; then
    ALEMBIC="$MIGRATION_DIR/.venv/bin/alembic"
  elif [ -f "$MIGRATION_DIR/.venv/Scripts/alembic.exe" ]; then
    ALEMBIC="$MIGRATION_DIR/.venv/Scripts/alembic.exe"
  fi
  if [ -n "${ALEMBIC:-}" ] && [ -f "$ALEMBIC" ]; then
    HAS_ALEMBIC=true
  fi
fi

if $HAS_ALEMBIC; then
  say "Migration roundtrip test"
  cd "$MIGRATION_DIR"

  export DATABASE_URL="${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/vptest}"

  # Roundtrip: ensure head → downgrade one → upgrade back
  if "$ALEMBIC" upgrade head 2>&1; then
    if "$ALEMBIC" downgrade -1 2>&1; then
      if "$ALEMBIC" upgrade head 2>&1; then
        ok "alembic upgrade/downgrade roundtrip"
      else
        fail "alembic re-upgrade failed after downgrade"
      fi
    else
      fail "alembic downgrade -1 failed — irreversible migration?"
    fi
  else
    fail "alembic upgrade head failed — migration cannot be applied"
  fi

  cd "$ROOT"
else
  say "Migration roundtrip skipped (no alembic or DB tooling)"
fi

# ═══ Frontend type check ═══
if [ -f "$ROOT/frontend/tsconfig.json" ]; then
  cd "$ROOT/frontend"
  if npx tsc --noEmit 2>&1; then
    ok "tsc --noEmit"
  else
    fail "tsc --noEmit has errors"
  fi
  cd "$ROOT"
fi

# ═══ Migration conflict detection ═══
if git diff --cached --name-only -- backend/migrations/versions/ 2>/dev/null | grep -q '.'; then
  if git diff --cached -- backend/migrations/versions/ | grep -qE '^\+<<<<<<<|^\+=======|^\+>>>>>>>'; then
    fail "merge conflict markers in migration files — resolve before pushing"
  else
    ok "no merge conflicts in migrations"
  fi
fi

pattern='^v([0-9]{4})\.([0-9]{2})\.([0-9]{2})-([1-9][0-9]*)$'
today=$(date +%Y.%m.%d 2>/dev/null || date -u +%Y.%m.%d 2>/dev/null || echo "")

if [ -z "$today" ]; then
  echo "  ${RED}WARNING${NC}: cannot determine today's date, date validation skipped"
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*)
      tag="${remote_ref#refs/tags/}"

      # 1. Pattern match
      if ! echo "$tag" | grep -qE "$pattern"; then
        echo ""
        echo "  Invalid tag: $tag"
        echo "  Expected: vYYYY.MM.DD-N  (e.g. v${today}-1)"
        fail "tag format"
        continue
      fi

      # 2. Validate date (skip if cannot determine today)
      if [ -n "$today" ]; then
        tag_date=$(echo "$tag" | sed -E 's/^v([0-9]{4}\.[0-9]{2}\.[0-9]{2})-.*/\1/')
        if [ "$tag_date" != "$today" ]; then
          fail "tag date $tag_date != today $today"
          continue
        fi
      fi

      # 3. Validate counter — use remote tags to determine highest
      tag_num=$(echo "$tag" | sed -E 's/^v[0-9.]+-//')
      prefix="v${today}-"

      git fetch --tags origin 2>/dev/null || true
      existing=$(git tag -l "${prefix}*" | grep -v "^${tag}$" | sed "s/${prefix}//" | sort -n)
      if [ -z "$existing" ]; then
        highest=0
      else
        highest=$(echo "$existing" | tail -1)
      fi
      expected=$((highest + 1))

      if [ "$tag_num" -ne "$expected" ]; then
        fail "tag ${tag}: expected counter ${expected} (highest today: ${highest:-none}), got ${tag_num}"
        continue
      fi

      ok "tag $tag"
      ;;
  esac
done

echo ""
if [ $PASS -eq 0 ]; then
  echo "  ${GREEN}pre-push ok${NC}"
else
  echo "  ${RED}pre-push FAILED${NC}"
fi
echo ""

exit $PASS
