#!/bin/sh
# Pre-push: type check + migration conflict detection + tag validation
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0

# 测试清单强制校验开关：大规模重构期间暂时关闭。恢复该门禁改回 true。
ENFORCE_CHECKLIST=false

say()  { echo "$1"; }
ok()   { echo "  ok  $1"; }
fail() { echo "  FAIL $1"; PASS=1; }

# ═══ Migration roundtrip test ═══
HAS_ALEMBIC=false
HAS_PSQL=false
if [ -f "$ROOT/backend/alembic.ini" ]; then
  MIGRATION_DIR="$ROOT/backend"
  if [ -f "$MIGRATION_DIR/.venv/bin/alembic" ]; then
    ALEMBIC="$MIGRATION_DIR/.venv/bin/alembic"
  elif [ -f "$MIGRATION_DIR/.venv/Scripts/alembic.exe" ]; then
    ALEMBIC="$MIGRATION_DIR/.venv/Scripts/alembic.exe"
  fi
  if [ -n "${ALEMBIC:-}" ] && [ -f "$ALEMBIC" ]; then
    HAS_ALEMBIC=true
  fi
  if command -v psql >/dev/null 2>&1; then
    HAS_PSQL=true
  fi
fi

if $HAS_ALEMBIC; then
  say "Migration roundtrip test"

  # 优先读取 .env 中的数据库连接信息
  if [ -f "$ROOT/.env" ]; then
    # shellcheck source=/dev/null
    . "$ROOT/.env"
  fi

  PGUSER="${PGUSER:-postgres}"
  PGPASSWORD="${PGPASSWORD:-postgres}"
  PGHOST="${PGHOST:-localhost}"
  PGPORT="${PGPORT:-5432}"
  export PGUSER PGPASSWORD PGHOST PGPORT

  TEMP_DB="vptest_roundtrip_$$"
  # GNU timeout has --help; Windows TIMEOUT does not. Use it only when GNU.
  if command -v timeout >/dev/null 2>&1 && timeout --help 2>/dev/null | grep -q "timeout"; then
    TOCMD="timeout 30"
    TOCMD_LONG="timeout 120"
  else
    TOCMD=""
    TOCMD_LONG=""
  fi

  if $HAS_PSQL; then
    if $TOCMD psql -d postgres -c "CREATE DATABASE \"$TEMP_DB\";" >/dev/null 2>&1; then
      trap "$TOCMD psql -d postgres -c \"DROP DATABASE IF EXISTS \\\"$TEMP_DB\\\" WITH (FORCE);\" >/dev/null 2>&1 || true" EXIT
    else
      fail "cannot create temp database $TEMP_DB"
      cd "$ROOT" || exit 1
      exit 1
    fi
    export DATABASE_URL="postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${TEMP_DB}"
  else
    export DATABASE_URL="${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/vptest}"
  fi

  cd "$MIGRATION_DIR" || exit 1

  if $TOCMD_LONG "$ALEMBIC" upgrade head 2>&1; then
    if $TOCMD_LONG "$ALEMBIC" downgrade base 2>&1; then
      if $TOCMD_LONG "$ALEMBIC" upgrade head 2>&1; then
        ok "alembic full upgrade/downgrade roundtrip (base → head → base → head)"
      else
        fail "alembic re-upgrade failed after full downgrade"
      fi
    else
      fail "alembic downgrade base failed — irreversible migration?"
    fi
  else
    fail "alembic upgrade head failed — migration cannot be applied"
  fi

  cd "$ROOT" || exit 1
else
  say "Migration roundtrip skipped (no alembic or DB tooling)"
fi

# ═══ Migration conflict detection ═══
if git diff --cached --name-only -- backend/migrations/versions/ 2>/dev/null | grep -q '.'; then
  if git diff --cached -- backend/migrations/versions/ | grep -qE '^\+<<<<<<<|^\+=======|^\+>>>>>>>'; then
    fail "merge conflict markers in migration files — resolve before pushing"
  else
    ok "no merge conflicts in migrations"
  fi
fi

# ═══ Migration location check — no files should be in versions/ root ═══
if git diff --cached --name-only -- 'backend/migrations/versions/*.py' 2>/dev/null | grep -vE '(ddl/|data/|__pycache__)' | grep -q '\.py$'; then
  fail "new migration files must go in versions/ddl/ or versions/data/, not versions/ root"
fi

pattern='^v([0-9]{4})\.([0-9]{2})\.([0-9]{2})-([1-9][0-9]*)$'
today=$(date -u -d '+8 hours' +%Y.%m.%d 2>/dev/null || TZ=Asia/Shanghai date +%Y.%m.%d 2>/dev/null || echo "")

if [ -z "$today" ]; then
  echo "  WARNING: cannot determine today's date, date validation skipped"
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*)
      # Skip tag deletions (local_sha is all zeros)
      case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
      esac

      tag="${remote_ref#refs/tags/}"

      # 1. Pattern match
      if ! echo "$tag" | grep -qE "$pattern"; then
        echo ""
        echo "  Invalid tag: $tag"
        echo "  Expected: vYYYY.MM.DD-N  (e.g. v${today}-1)"
        fail "tag format"
        continue
      fi

      # 2. Validate date (skip if cannot determine today)
      if [ -n "$today" ]; then
        tag_date=$(echo "$tag" | sed -E 's/^v([0-9]{4}\.[0-9]{2}\.[0-9]{2})-.*/\1/')
        if [ "$tag_date" != "$today" ]; then
          fail "tag date $tag_date != today $today"
          continue
        fi
      fi

      # 3. Validate counter — use remote tags to determine highest
      tag_num=$(echo "$tag" | sed -E 's/^v[0-9.]+-//')
      prefix="v${today}-"

      git fetch --tags origin 2>/dev/null || true
      existing=$(git tag -l "${prefix}*" | grep -v "^${tag}$" | sed "s/${prefix}//" | sort -n)
      if [ -z "$existing" ]; then
        highest=0
      else
        highest=$(echo "$existing" | tail -1)
      fi
      expected=$((highest + 1))

      if [ "$tag_num" -ne "$expected" ]; then
        fail "tag ${tag}: expected counter ${expected} (highest today: ${highest:-none}), got ${tag_num}"
        continue
      fi

      # 4. Testing checklist (only required for feat/fix versions)
      month=$(echo "${tag#v}" | cut -d. -f1-2)
      checklist="docs/testing/${month}/checklist-${tag}.md"

      prev_tag=$(git tag --sort=version:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+-[0-9]+$' | grep -B1 "^${tag}$" | head -1 || echo "")
      has_feat_or_fix=false
      if [ -n "$prev_tag" ] && [ "$prev_tag" != "$tag" ]; then
        # Reliably detect feat/fix via Python (handles Unicode emoji on all platforms)
        if uv run python -c "
import subprocess, sys
log = subprocess.check_output(['git','log','${prev_tag}..HEAD','--oneline','--no-merges'], text=True)
sys.exit(0 if '\u2728 feat:' in log or '\U0001f41b fix:' in log else 1)
" 2>/dev/null; then
          has_feat_or_fix=true
        fi
      fi

      if $has_feat_or_fix && [ "$ENFORCE_CHECKLIST" = "true" ]; then
        # User-facing changes — require a real checklist (>30 chars of content)
        if [ ! -f "$ROOT/$checklist" ]; then
          echo ""
          echo "PUSH BLOCKED: missing $checklist (feat/fix commits detected)"
          echo "→ generate the checklist, commit it, and re-run 'pnpm run tag'"
          echo ""
          fail "testing checklist required for feat/fix versions"
        else
          content=$(cat "$ROOT/$checklist" 2>/dev/null | tr -d '[:space:]')
          if [ ${#content} -lt 30 ]; then
            echo ""
            echo "PUSH BLOCKED: $checklist is too short (${#content} chars — stub or '无需测试')"
            echo "→ generate a real checklist with scene-level test steps"
            echo ""
            fail "checklist too short for feat/fix version"
          else
            ok "testing checklist for $tag"
          fi
        fi
      fi

      ok "tag $tag"
      ;;
  esac
done

echo ""
if [ $PASS -eq 0 ]; then
  echo "  pre-push ok"
else
  echo "  pre-push FAILED"
fi
echo ""

exit $PASS
