#!/bin/sh
# Pre-push: tag format validation only (CI handles the rest)
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

say()  { echo "${CYAN}$1${NC}"; }
ok()   { echo "  ${GREEN}ok${NC}  $1"; }
fail() { echo "  ${RED}FAIL${NC} $1"; PASS=1; }

pattern='^v[0-9]{4}\.[0-9]{2}\.[0-9]{2}(-[1-9][0-9]*)?$'

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*)
      tag="${remote_ref#refs/tags/}"
      if ! echo "$tag" | grep -qE "$pattern"; then
        echo ""
        echo "  Invalid tag: $tag"
        echo "  Expected: vYYYY.MM.DD or vYYYY.MM.DD-N"
        PASS=1
      else
        ok "tag $tag"
      fi
      ;;
  esac
done

echo ""
if [ $PASS -eq 0 ]; then
  echo "  ${GREEN}pre-push ok${NC}"
else
  echo "  ${RED}pre-push FAILED${NC}"
fi
echo ""

exit $PASS
