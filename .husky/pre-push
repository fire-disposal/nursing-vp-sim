#!/bin/sh
# Validate tag format: vYYYY.MM.DD or vYYYY.MM.DD-N

pattern='^v[0-9]{4}\.[0-9]{2}\.[0-9]{2}(-[1-9][0-9]*)?$'
exit_code=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*)
      tag="${remote_ref#refs/tags/}"
      if ! echo "$tag" | grep -qE "$pattern"; then
        echo ""
        echo "  Invalid tag: $tag"
        echo "  Expected: vYYYY.MM.DD or vYYYY.MM.DD-N (e.g. v2026.05.29, v2026.05.29-3)"
        exit_code=1
      fi
      ;;
  esac
done

if [ $exit_code -ne 0 ]; then
  echo ""
  echo "  Push rejected. Run 'git tag -d $tag' to remove invalid tag."
  echo ""
fi

exit $exit_code
