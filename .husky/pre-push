#!/bin/sh
# Pre-push quality gates — local CI mirror.
#  SKIP_PREPUSH=1    git push    → skip all checks
#  PREUSH_FAST=1     git push    → skip frontend typecheck (slower)
#  npm run tag                    → auto-generate valid tag

set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

say()  { echo "${CYAN}$1${NC}"; }
ok()   { echo "  ${GREEN}ok${NC}  $1"; }
fail() { echo "  ${RED}FAIL${NC} $1"; PASS=1; }

# ── escape hatch ──────────────────────────────────────────────
if [ -n "$SKIP_PREPUSH" ]; then
  say "SKIP_PREPUSH  set — bypassing all quality checks"
  exit 0
fi

# ── frontend ──────────────────────────────────────────────────
say "─ frontend ─"

if [ -f "$ROOT/frontend/package.json" ]; then
  (cd "$ROOT/frontend" && npx biome check src/ --max-diagnostics 20) \
    && ok "biome lint" || fail "biome lint"

  if [ -z "$PREUSH_FAST" ]; then
    (cd "$ROOT/frontend" && npx tsc --noEmit) \
      && ok "tsc typecheck" || fail "tsc typecheck"
  else
    say "  (tsc typecheck skipped — PREUSH_FAST)"
  fi
else
  say "  (no frontend/)"
fi

# ── backend ───────────────────────────────────────────────────
say "─ backend ─"

if [ -f "$ROOT/backend/pyproject.toml" ]; then
  (cd "$ROOT/backend" && uv run ruff check .) \
    && ok "ruff check" || fail "ruff check"

  (cd "$ROOT/backend" && uv run ruff format --check .) \
    && ok "ruff format" || fail "ruff format"
else
  say "  (no backend/)"
fi

# ── tag format validation (existing) ──────────────────────────
pattern='^v[0-9]{4}\.[0-9]{2}\.[0-9]{2}(-[1-9][0-9]*)?$'

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*)
      tag="${remote_ref#refs/tags/}"
      if ! echo "$tag" | grep -qE "$pattern"; then
        echo ""
        echo "  Invalid tag: $tag"
        echo "  Expected: vYYYY.MM.DD or vYYYY.MM.DD-N"
        echo "  Use 'npm run tag' to auto-generate and push a valid tag."
        PASS=1
      fi
      ;;
  esac
done

# ── result ────────────────────────────────────────────────────
echo ""
if [ $PASS -eq 0 ]; then
  echo "  ${GREEN}pre-push ok${NC}"
else
  echo "  ${RED}pre-push FAILED${NC} — fix above and retry, or SKIP_PREPUSH=1 to bypass"
fi
echo ""

exit $PASS
