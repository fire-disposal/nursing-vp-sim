  "rubric": [
    {
      "id": "dp_conflict",
      "title": "是否识别并处理「体征与陈述不一致」这个矛盾",
      "rule": "action_set_covers",
      "params": {
        "affordances": [
          "measure_bp",
          "ask_history",
          "ask_meds",
          "ask_record"
        ],
        "min": 3,
        "accept_custom": [
          "矛盾",
          "不一致",
          "否认",
          "瞒",
          "不是没有",
          "两种说法"
        ]
      },
      "anchors": {
        "strong": "量到了、也核对了第三方证据，明确指出两者不一致",
        "adequate": "量到了并问过，但把「他说没有」当成结论",
        "missed": "照清单记成「无高血压史」"
      },
      "weight": 40
    },
    {
      "id": "dp_no_dismiss",
      "title": "是否用第三条路求证（用药 / 旧记录 / 复测）",
      "rule": "action_set_covers",
      "params": {
        "affordances": [
          "ask_meds",
          "ask_record",
          "measure_bp_again",
          "wait_rest_recheck"
        ],
        "min": 1
      },
      "anchors": {
        "strong": "主动找了不依赖他承认的证据",
        "adequate": "复测了一次，但没有追证据",
        "missed": "只以他的口头陈述为准"
      },
      "weight": 30
    },
    {
      "id": "dp_trust",
      "title": "追问是否合分寸（没有反复逼问同一件事）",
      "rule": "avoid_repeat",
      "params": {
        "affordance_id": "ask_history",
        "max": 1
      },
      "anchors": {
        "strong": "问过一次就换路径求证",
        "adequate": "问了两次但随后调整了方式",
        "missed": "反复逼问，把他问得更设防"
      },
      "weight": 15
    },
    {
      "id": "dp_document",
      "title": "是否把不一致与下一步写进入院记录",
      "rule": "action_set_covers",
      "params": {
