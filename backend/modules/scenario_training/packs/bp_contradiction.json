{
  "key": "bp-contradiction",
  "title": "入院检查：量出来像高血压，患者坚决否认",
  "one_line": "一次入院检查：患者说他身体好得很，血压计不这么认为。",
  "player": {
    "role": "入院责任护士"
  },
  "setting": {
    "place": "内科病房",
    "time_hint": "上午 09:20",
    "resources": [
      "血压计",
      "床头柜",
      "既往就诊记录",
      "入院评估单"
    ],
    "cues": [
      {
        "id": "c_denial",
        "text": "他反复说「我没有高血压，我身体好得很」，语气很坚决。",
        "visible_from_start": true
      },
      {
        "id": "c_impatient",
        "text": "他答话时眼睛看着窗外，手指敲着床边。",
        "visible_from_start": true
      },
      {
        "id": "c_bp_high",
        "text": "袖带读数偏高，左右臂差别不大。"
      },
      {
        "id": "c_bp_retake",
        "text": "换另一侧复测，结果和第一次一致。"
      },
      {
        "id": "c_bp_rest",
        "text": "静息 5 分钟后再测，读数没下来——不是一时紧张。"
      },
      {
        "id": "c_pills",
        "text": "床头抽屉里有半板白色小药片；他说「就那种小小白药片，降压的？我不清楚」。"
      },
      {
        "id": "c_record",
        "text": "既往就诊记录里有一次 165/95 mmHg 的记载，但诊断一栏写着「待查」。"
      }
    ]
  },
  "actors": [
    {
      "id": "patient",
      "role": "患者",
      "presence": "on_site",
      "demand": "neutral",
      "knowledge": {
        "主诉": "我没什么病，就是来做个检查",
        "自述": "我没有高血压，别给我记这个",
        "抽屉": "半板白色小药片（他自己也说不清是什么）"
      },
      "style": "不认为自己有病；被直接追问「有没有高血压」时回避、否认甚至不耐烦；被问到具体用药或旧记录时会含糊但会松口",
      "goals": [
        "证明自己身体没问题",
        "尽快把检查做完"
      ]
    }
