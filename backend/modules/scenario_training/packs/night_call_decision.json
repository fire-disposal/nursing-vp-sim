  "rubric": [
    {
      "id": "dp_gather",
      "rule": "action_set_covers",
      "params": {
        "affordances": [
          "ask_abdomen",
          "ask_urine",
          "ask_history"
        ],
        "min": 2,
        "accept_custom": [
          "反跳痛",
          "尿量",
          "既往",
          "进食"
        ]
      },
      "anchors": {
        "strong": "问了腹部体征并至少核到另一项",
        "adequate": "问到了其中一项",
        "missed": "只复述护士已经报过的数字"
      },
      "title": "在电话里问到了哪些关键信息（而不是只重复已有数据）",
      "weight": 25
    },
    {
      "id": "dp_next_test",
      "rule": "option_choice",
      "params": {
        "affordances": [
          "order_tests",
          "hold_observation"
