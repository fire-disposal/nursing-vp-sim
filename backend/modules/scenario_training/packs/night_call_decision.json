        "correct": [
          "lactate",
          "ultrasound"
        ],
        "acceptable": [
          "ecg",
          "catheter"
        ],
        "accept_custom": [
          "乳酸",
          "血常规",
          "超声",
          "游离液体",
          "急腹症",
          "外科"
        ]
      },
      "anchors": {
        "strong": "要了乳酸/血常规或床旁超声；或自输入点出需要外科介入",
