        "id": "c_restless",
        "text": "患者坐起前倾，说话断续，额头发汗。",
        "visible_from_start": true
      },
      {
        "id": "c_secretions",
        "text": "床旁吸引器就位，痰液黏稠、量多。",
        "visible_from_start": true
      },
