  "rubric": [
    {
      "id": "dp_recognize",
      "rule": "action_set_covers",
      "params": {
        "affordances": [
          "auscultate",
          "measure_spo2"
        ],
        "min": 2,
        "accept_custom": [
          "听诊",
          "呼吸音",
          "痰栓",
          "堵塞",
          "吸不出"
        ]
      },
      "anchors": {
        "strong": "测了血氧并听诊，明确指出吸痰取不出深部痰、单侧通气受损",
        "adequate": "测了血氧或听诊之一，意识到吸痰无效",
        "missed": "只看血氧数字，或完全依赖吸痰"
      },
      "title": "是否识别「吸痰无效 + 单侧呼吸音消失」提示深部痰栓 / 单侧堵塞",
      "weight": 25
    },
    {
      "id": "dp_no_repeat",
      "rule": "avoid_repeat",
      "params": {
        "affordance_id": "suction",
        "max": 1
      },
      "anchors": {
        "strong": "吸痰一次后即停止，转而重新评估",
        "adequate": "吸痰两次但随后改变思路",
        "missed": "反复吸痰三次以上"
      },
      "title": "是否停止重复无效的吸痰",
      "weight": 30
    },
    {
      "id": "dp_escalate",
      "rule": "require_within",
      "params": {
        "affordances": [
          "bag_valve",
          "call_doctor"
        ],
        "within_turns": 3
      },
      "anchors": {
        "strong": "三轮内上手加压给氧并呼叫医生",
        "adequate": "三轮内做到其中之一",
        "missed": "始终没有升级"
      },
      "title": "是否及时升级（加压给氧 / 呼叫医生）",
      "weight": 30
    },
    {
      "id": "dp_sequence",
      "rule": "action_order",
      "params": {
        "first": [
          "auscultate",
          "measure_spo2"
        ],
        "then": [
          "bag_valve",
          "call_doctor"
        ]
      },
      "anchors": {
        "strong": "先看清体征（听诊 / 血氧）再加压给氧或呼叫医生",
        "adequate": "评估与升级交错，但顺序合理",
        "missed": "没有任何评估就盲目处置"
      },
      "title": "是否先重新评估再升级处置",
      "weight": 10
    },
    {
      "id": "dp_document",
      "rule": "action_set_covers",
      "params": {
        "affordances": [
          "document"
        ],
        "min": 1
      },
      "anchors": {
        "strong": "记录了观察、处置与患者反应",
