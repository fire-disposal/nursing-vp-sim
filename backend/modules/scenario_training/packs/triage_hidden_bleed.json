      "role": "患者",
      "presence": "on_site",
      "demand": "quiet",
      "knowledge": {
        "主诉": "搬箱子闪了腰",
        "需求": "开点膏药回家接孩子",
        "实情": "突发左上腹疼伴左肩酸，现在有点头晕"
      },
      "style": "忍着、不爱麻烦人，倾向把话说小；被问到具体经过时才会补出关键信息",
      "goals": [
        "快点回家"
      ],
      "dm_writable": [
