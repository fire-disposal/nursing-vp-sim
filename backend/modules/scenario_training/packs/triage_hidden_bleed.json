{
  "pack_schema_version": 3,
  "key": "triage-hidden-bleed",
  "title": "预检分诊：说「腰闪了」的那个人",
  "state": "experimental",
  "one_line": "他扶着墙走进预检台，说自己只是搬东西闪了腰，想开点膏药就回家。",
  "player": {
    "role": "预检分诊护士",
    "can": [
      "ask",
      "observe",
      "measure",
      "act",
      "document",
      "summon"
    ]
  },
  "setting": {
    "place": "急诊预检台",
    "time_hint": "傍晚 18:40",
    "resources": [
      "分诊系统",
      "血压计与监护",
      "平车",
      "抢救区呼叫铃"
    ],
    "cues": [
      {
        "id": "c_grip",
        "text": "他扶着分诊台边缘站着，不太敢直起腰。",
        "visible_from_start": true
      },
      {
        "id": "c_pale",
        "text": "脸色发白、额角出汗，说话比刚进门时慢了半拍。",
        "visible_from_start": true
      },
      {
        "id": "c_story",
        "text": "他说：「搬箱子闪了一下腰，给我开点膏药，我得回去接孩子。」",
        "visible_from_start": true
      },
      {
        "id": "c_vitals",
        "text": "脉搏 118、血压 92/58、四肢发凉。",
        "visible_from_start": false
      },
      {
        "id": "c_shoulder",
        "text": "追问搬箱子那一刻，他说「一下就疼起来了，左肩膀也酸」。",
        "visible_from_start": false
      },
      {
        "id": "c_guarding",
        "text": "他没有明显的腰部压痛点，反而左侧一碰就躲。",
        "visible_from_start": false
      },
      {
        "id": "c_shock",
        "text": "抢救区医生接手：「先按内出血走，床旁超声马上到。」",
        "visible_from_start": false
      }
    ]
  },
  "actors": [
