{
  "key": "two-beds-priority",
  "title": "两床同铃：会叫的能等，不叫的危重",
  "one_line": "夜班，两床同时按铃：一个喊得整条走廊都听见，一个只说了句「有点闷」。",
  "player": {
    "role": "夜班护士"
  },
  "setting": {
    "place": "呼吸内科病房（夜班）",
    "time_hint": "凌晨 03:40",
    "resources": [
      "监护仪",
      "氧气装置",
      "无创呼吸机",
      "镇痛泵",
      "呼叫铃"
    ],
    "cues": [
      {
        "id": "c_a_ringing",
        "text": "A 床的呼叫铃一直在响，隔着走廊都能听见他在喊。",
        "visible_from_start": true
      },
      {
        "id": "c_b_dark",
        "text": "B 床那侧只亮着床头监护仪的冷光，人没出声。",
        "visible_from_start": true
      },
      {
        "id": "c_family_outside",
        "text": "A 床家属攥着水杯站在走廊里来回踱步。",
        "visible_from_start": true
      },
      {
        "id": "c_a_stable",
        "text": "A 床伤口敷料干燥，生命体征平稳——疼是真疼，但不像要出事。"
      },
      {
        "id": "c_b_barely_answers",
        "text": "B 床老人应了一声，声音又轻又慢，像是费了很大力气。"
      },
      {
        "id": "c_b_low_sat",
        "text": "B 床指夹血氧 88%，呼吸浅快、鼻翼翕动。"
      },
      {
        "id": "c_b_confused",
        "text": "B 床答话开始不对劲：说自己在老家，还问什么时候能回去。"
      }
    ]
  },
