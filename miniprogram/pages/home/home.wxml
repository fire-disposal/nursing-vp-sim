<view class="page">
  <view class="header">
    <view class="header-greeting">
      <text class="greeting-text">你好，{{userName || '同学'}}</text>
      <text class="greeting-sub">今天开始新的训练吧</text>
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-value">{{totalSessions}}</text>
      <text class="stat-label">训练次数</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{totalMinutes}}</text>
      <text class="stat-label">累计分钟</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{avgScore}}</text>
      <text class="stat-label">平均得分</text>
    </view>
  </view>

  <!-- 作业任务 -->
  <view class="section" wx:if="{{assignments.length > 0}}">
    <view class="section-header">
      <text class="section-title">待完成作业</text>
      <text class="section-subtitle">{{assignments.length}} 项</text>
    </view>
    <view
      class="assignment-card"
      wx:for="{{assignments}}"
      wx:key="id"
      bindtap="startFromAssignment"
      data-id="{{item.id}}"
    >
      <view class="assign-left">
        <text class="assign-name">{{item.case_name}}</text>
        <text class="assign-class">{{item.class_name || item.teacher_name || '教师发布'}}</text>
        <text class="assign-deadline">
          截止 {{item.end_time}}
        </text>
      </view>
      <view class="assign-right">
        <text class="assign-status assign-{{item.status}}">
          {{item.status === 'completed' ? '已完成' : item.status === 'overdue' ? '已逾期' : '待开始'}}
        </text>
        <text class="assign-arrow" wx:if="{{item.status !== 'completed'}}">›</text>
      </view>
    </view>
  </view>

  <view class="section">"
    <view class="section-header">
      <text class="section-title">快速开始</text>
    </view>
    <view class="action-row">
      <view class="action-card" bindtap="goToCases">
        <view class="action-left">
          <view class="action-icon-wrap">
            <text class="action-icon">🩺</text>
          </view>
          <view>
            <text class="action-title">开始新训练</text>
            <text class="action-desc">选择病例，与虚拟患者对话</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-card" bindtap="goToQA">
        <view class="action-left">
          <view class="action-icon-wrap qa-icon-wrap">
            <text class="action-icon">💬</text>
          </view>
          <view>
            <text class="action-title">护理问答</text>
            <text class="action-desc">护理知识AI智能解答</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 本周训练趋势 -->
  <view class="section" wx:if="{{weeklyTrend.length > 0}}">
    <view class="section-header">
      <text class="section-title">本周训练</text>
      <text class="section-subtitle">共 {{weeklyMax > 0 ? '★'.repeat(Math.min(weeklyMax, 3)) : ''}} 次活跃</text>
    </view>
    <view class="trend-chart">
      <view class="trend-bar-group" wx:for="{{weeklyTrend}}" wx:key="label">
        <text class="trend-value" wx:if="{{item.value > 0}}">{{item.value}}</text>
        <view class="trend-bar {{item.value > 0 ? 'trend-bar-active' : ''}}" style="height: {{item.height}}px"></view>
        <text class="trend-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 最新得分 -->
  <view class="section" wx:if="{{latestScore}}">
    <view class="section-header">
      <text class="section-title">最近得分</text>
    </view>
    <view class="score-card-widget">
      <view class="score-circle">
        <text class="score-number">{{latestScore.total}}</text>
        <text class="score-unit">分</text>
      </view>
      <view class="score-info">
        <text class="score-grade" wx:if="{{latestScore.total >= 90}}">优秀</text>
        <text class="score-grade" wx:elif="{{latestScore.total >= 75}}">良好</text>
        <text class="score-grade" wx:elif="{{latestScore.total >= 60}}">合格</text>
        <text class="score-grade" wx:else>需加强</text>
        <text class="score-hint">继续努力提升护理技能</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{recommendedCases.length > 0}}">
    <view class="section-header">
      <text class="section-title">推荐病例</text>
    </view>
    <scroll-view scroll-x class="case-scroll">
      <view
        class="case-row"
        wx:for="{{recommendedCases}}"
        wx:key="id"
        bindtap="startFromCase"
        data-id="{{item.id}}"
      >
        <view class="case-badge case-badge-{{item.difficulty}}">
          {{item.difficulty === 1 ? '★☆☆' : item.difficulty === 2 ? '★★☆' : '★★★'}}
        </view>
        <text class="case-name">{{item.name}}</text>
        <text class="case-desc-scroll">{{item.description}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="section" wx:if="{{recentRecords.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近训练</text>
    </view>
    <view
      class="record-row"
      wx:for="{{recentRecords}}"
      wx:key="id"
      bindtap="goToRecord"
      data-id="{{item.id}}"
    >
      <view class="record-icon">📋</view>
      <view class="record-info">
        <text class="record-name">{{item.case_name}}</text>
        <text class="record-time">{{item.timeLabel}}</text>
      </view>
      <view class="record-right">
        <text class="record-score {{item.scoreLabel && item.scoreLabel.color === '#16a34a' ? 'text-green' : item.scoreLabel && item.scoreLabel.color === '#dc2626' ? 'text-red' : 'text-amber'}}" wx:if="{{item.score_total != null}}">
          {{item.score_total}}分
        </text>
        <text class="record-status text-secondary" wx:else>{{item.status === 'in_progress' ? '进行中' : '未评分'}}</text>
        <text class="record-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && recentRecords.length === 0}}">
    <view class="empty-icon-wrap">
      <text class="empty-icon">📋</text>
    </view>
    <text class="empty-text">暂无训练记录</text>
    <text class="empty-desc">开始你的第一次模拟训练吧</text>
  </view>
</view>
