<view class="page">
  <view class="back-bar">
    <view class="back-btn" bindtap="goBack">← 返回</view>
  </view>
  <view class="header">
    <view class="header-title">我的问卷回答</view>
    <view class="header-desc">查看提交过的前后测问卷回答记录</view>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <block wx:if="{{responses.length === 0}}">
      <view class="empty-state">
        <view class="empty-icon">📋</view>
        <text class="empty-title">暂无问卷回答记录</text>
        <text class="empty-desc">完成训练的前后测问卷后，回答记录会显示在这里</text>
      </view>
    </block>

    <block wx:else>
      <view class="response-list">
        <view
          class="response-item"
          wx:for="{{responses}}"
          wx:key="id"
          data-response="{{item}}"
          bindtap="onViewDetail"
        >
          <view class="response-info">
            <text class="response-title">{{item.template_title}}</text>
            <view class="response-meta">
              <text class="response-time">{{item.completed_at || item.created_at}}</text>
              <text class="response-status {{item.status === 'completed' ? 'status-done' : 'status-pending'}}">
                {{item.status === 'completed' ? '已完成' : '进行中'}}
              </text>
            </view>
          </view>
          <view class="response-arrow">›</view>
        </view>
      </view>

      <view class="load-more" wx:if="{{responses.length < total}}" bindtap="onLoadMore">
        <text>加载更多</text>
      </view>
    </block>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="error-state" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="loadResponses">重试</view>
  </view>

  <!-- 详情弹窗 -->
  <view class="mask" wx:if="{{detailResponse}}" bindtap="onCloseDetail"></view>
  <view class="detail-panel {{detailResponse ? 'panel-visible' : ''}}">
    <view class="detail-header">
      <text class="detail-title">{{detailResponse.template_title}}</text>
      <view class="detail-close" bindtap="onCloseDetail">✕</view>
    </view>
    <view class="detail-body">
      <view class="detail-meta">
        <text class="detail-time">提交时间: {{detailResponse.completed_at || detailResponse.created_at}}</text>
        <text class="detail-status {{detailResponse.status === 'completed' ? 'status-done' : 'status-pending'}}">
          {{detailResponse.status === 'completed' ? '已完成' : '进行中'}}
        </text>
      </view>
      <view class="answer-list">
        <view
          class="answer-item"
          wx:for="{{detailResponse.answers}}"
          wx:key="question_id"
          wx:for-index="idx"
        >
          <view class="a-question">
            <text class="a-index">{{idx + 1}}.</text>
            <text class="a-content">{{item.question_content}}</text>
          </view>
          <view class="a-value">
            <block wx:if="{{item.question_type === 'likert_5' && item.answer_value}}">
              <text class="a-likert">{{item.answer_value}} - {{likertLabels[item.answer_value - 1] || item.answer_value}}</text>
            </block>
            <block wx:elif="{{item.answer_value}}">
              <text class="a-answer">{{item.answer_value}}</text>
            </block>
            <block wx:else>
              <text class="a-empty">未作答</text>
            </block>
          </view>
        </view>
      </view>
      <view class="detail-empty" wx:if="{{!detailResponse.answers || detailResponse.answers.length === 0}}">
        <text>暂无回答记录</text>
      </view>
    </view>
  </view>
</view>
