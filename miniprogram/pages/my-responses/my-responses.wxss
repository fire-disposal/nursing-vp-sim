.page {
  min-height: 100vh;
  background: #f5f6f8;
}

.back-bar { padding: 16rpx 36rpx 0; padding-top: max(env(safe-area-inset-top), 16rpx); }
.back-btn { font-size: 26rpx; color: #2563eb; display: inline-block; padding: 4rpx 0; }

.header {
  background: #fff;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.header-desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.content {
  padding: 24rpx 36rpx 40rpx;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
  padding: 0 40rpx;
}

/* Response list */
.response-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.response-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.response-info {
  flex: 1;
  min-width: 0;
}

.response-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.response-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.response-time {
  font-size: 24rpx;
  color: #9ca3af;
}

.response-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-done {
  background: #ecfdf5;
  color: #059669;
}

.status-pending {
  background: #eff6ff;
  color: #2563eb;
}

.response-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: #2563eb;
}

/* Loading */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.error-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 80rpx 0; gap: 16rpx;
}
.error-text { font-size: 26rpx; color: #dc2626; }
.retry-btn {
  padding: 12rpx 32rpx; background: #2563eb; color: #fff;
  border-radius: 40rpx; font-size: 26rpx;
}

/* Detail panel */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.detail-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  display: flex;
  flex-direction: column;
}

.panel-visible {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
  flex-shrink: 0;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #9ca3af;
  background: #f3f4f6;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.detail-body {
  padding: 24rpx 36rpx 48rpx;
  overflow-y: auto;
  flex: 1;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.detail-time {
  font-size: 24rpx;
  color: #9ca3af;
}

.detail-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.answer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.answer-item {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 24rpx;
}

.a-question {
  display: flex;
  gap: 6rpx;
  margin-bottom: 12rpx;
}

.a-index {
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
  flex-shrink: 0;
}

.a-content {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.5;
}

.a-value {
  padding-left: 0;
}

.a-likert {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

.a-answer {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 500;
}

.a-empty {
  font-size: 24rpx;
  color: #9ca3af;
  font-style: italic;
}

.detail-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #9ca3af;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
