<view class="page">
  <view class="topbar">
    <view class="topbar-left">
      <view class="sidebar-toggle" bindtap="onToggleSidebar">
        <text wx:if="{{!showSidebar}}">☰</text>
        <text wx:else>✕</text>
      </view>
      <text class="topbar-title">{{selectedTitle || '护理问答'}}</text>
    </view>
    <view class="topbar-right" wx:if="{{selectedSessionId}}">
      <view class="delete-btn" bindtap="onDeleteSession">🗑</view>
    </view>
  </view>

  <!-- 侧边栏遮罩 -->
  <view class="sidebar-mask" wx:if="{{showSidebar}}" bindtap="onToggleSidebar"></view>

  <!-- 侧边栏 -->
  <view class="sidebar {{showSidebar ? 'sidebar-open' : ''}}">
    <view class="sidebar-header">
      <text class="sidebar-header-text">会话列表</text>
    </view>
    <view class="session-list" wx:if="{{!loadingSessions}}">
      <block wx:if="{{sessions.length === 0}}">
        <view class="session-empty">暂无会话</view>
      </block>
      <view
        class="session-item {{item.id === selectedSessionId ? 'session-active' : ''}}"
        wx:for="{{sessions}}"
        wx:key="id"
        data-session="{{item}}"
        bindtap="onSelectSession"
      >
        <text class="session-title">{{item.title}}</text>
        <text class="session-meta">{{item.message_count}} 条消息</text>
      </view>
    </view>
    <view class="session-loading" wx:elif="{{sessionsError}}">
      <text>{{sessionsError}}</text>
      <view class="retry-btn" bindtap="loadSessions">重试</view>
    </view>

    <view class="session-loading" wx:else>
      <text>加载中...</text>
    </view>
  </view>

  <!-- 消息区域 -->
  <scroll-view class="chat-area" scroll-y scroll-into-view="msg-end">
    <view class="empty-state" wx:if="{{!loadingMessages && messages.length === 0 && !selectedSessionId}}">
      <text class="empty-icon">💬</text>
      <text class="empty-title">护理知识问答</text>
      <text class="empty-desc">输入你的护理问题，获取专业解答</text>
    </view>

    <view class="loading-state" wx:if="{{loadingMessages}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <view
      class="msg-row {{item.role === 'user' ? 'msg-right' : 'msg-left'}}"
      wx:for="{{messages}}"
      wx:key="id"
    >
      <view class="msg-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-assistant'}}">
        <text class="msg-content">{{item.content}}</text>
      </view>
    </view>
    <view id="msg-end"></view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input
      class="chat-input"
      value="{{input}}"
      placeholder="{{selectedSessionId ? '继续提问...' : '输入护理问题...'}}"
      bindinput="onInput"
      disabled="{{sending}}"
      confirm-type="send"
      bindconfirm="handleSend"
    />
    <button class="send-btn" bindtap="handleSend" disabled="{{sending || !input}}">
      {{sending ? '...' : '发送'}}
    </button>
  </view>
</view>
