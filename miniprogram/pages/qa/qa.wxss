.page { display: flex; flex-direction: column; height: 100vh; background: #f5f6f8; }

.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; padding-top: max(env(safe-area-inset-top), 44rpx);
  background: #fff; border-bottom: 1rpx solid #eee; flex-shrink: 0;
}

.topbar-left { display: flex; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }

.sidebar-toggle {
  font-size: 36rpx; width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.topbar-title {
  font-size: 30rpx; font-weight: 700; color: #111827;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.delete-btn {
  font-size: 36rpx; width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

/* Sidebar */
.sidebar-mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.3); z-index: 50; }

.sidebar {
  position: fixed; left: 0; top: 0; bottom: 0; width: 500rpx;
  background: #fff; z-index: 51;
  transform: translateX(-100%); transition: transform 0.3s ease-out;
}

.sidebar-open { transform: translateX(0); }

.sidebar-header {
  padding: 32rpx 24rpx 16rpx;
  padding-top: max(env(safe-area-inset-top), 44rpx);
}

.sidebar-header-text { font-size: 30rpx; font-weight: 700; color: #111827; }

.session-list { padding: 0 16rpx; }

.session-item {
  padding: 24rpx 16rpx; border-radius: 12rpx; margin-bottom: 8rpx;
}

.session-item:active { background: #f3f4f6; }

.session-active { background: #eff6ff; border: 1rpx solid #bfdbfe; }

.session-title {
  display: block; font-size: 26rpx; font-weight: 600; color: #111827;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.session-meta { display: block; font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }

.session-empty { text-align: center; padding: 40rpx 0; font-size: 26rpx; color: #9ca3af; }
.session-loading { text-align: center; padding: 40rpx 0; font-size: 26rpx; color: #9ca3af; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }

.retry-btn {
  display: inline-block; padding: 12rpx 32rpx;
  background: #2563eb; color: #fff; border-radius: 40rpx;
  font-size: 26rpx;
}

/* Chat */
.chat-area { flex: 1; padding: 24rpx; }
.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-left { justify-content: flex-start; }
.msg-right { justify-content: flex-end; }

.msg-bubble { max-width: 78%; padding: 18rpx 24rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.6; word-break: break-all; }
.bubble-assistant { background: #fff; border: 1rpx solid #e5e7eb; border-bottom-left-radius: 6rpx; }
.bubble-user { background: #2563eb; color: #fff; border-bottom-right-radius: 6rpx; }

.msg-content { white-space: pre-wrap; }

/* Empty & loading states */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; color: #374151; margin-bottom: 8rpx; }
.empty-desc { font-size: 26rpx; color: #9ca3af; text-align: center; }

.loading-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 80rpx 0; gap: 16rpx;
}

.loading-spinner {
  width: 48rpx; height: 48rpx; border: 4rpx solid #e5e7eb;
  border-top-color: #2563eb; border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* Input bar */
.input-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 20rpx; padding-bottom: max(env(safe-area-inset-bottom), 16rpx);
  background: #fff; border-top: 1rpx solid #e5e7eb; flex-shrink: 0;
}

.chat-input { flex: 1; height: 76rpx; background: #f3f4f6; border-radius: 40rpx; padding: 0 24rpx; font-size: 28rpx; }

.send-btn {
  width: 120rpx; height: 76rpx; background: #2563eb;
  color: #fff; border: none; border-radius: 40rpx;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.send-btn[disabled] { opacity: 0.4; }
