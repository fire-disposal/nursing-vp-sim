.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 0;
}

.header {
  background: #fff;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

.header-desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.content {
  padding: 24rpx 36rpx 120rpx;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.question-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.q-label {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.q-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #2563eb;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.q-content {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.5;
  flex: 1;
}

.q-required {
  color: #dc2626;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.likert-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.likert-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  background: #fff;
  transition: all 0.2s;
}

.likert-active {
  border-color: #2563eb;
  background: #eff6ff;
}

.likert-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.likert-active .likert-num {
  color: #2563eb;
}

.likert-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 0 4rpx;
}

.likert-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.text-right {
  text-align: right;
}

.choice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
  transition: all 0.2s;
}

.choice-item:last-child {
  margin-bottom: 0;
}

.choice-active {
  border-color: #2563eb;
  background: #eff6ff;
}

.choice-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.choice-active .choice-radio {
  border-color: #2563eb;
}

.radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2563eb;
}

.text-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  font-size: 28rpx;
  color: #374151;
  background: #fafafa;
  box-sizing: border-box;
}

.error-msg {
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 26rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 24rpx 36rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.btn-skip {
  padding: 0 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 12rpx;
  border: none;
}

.btn-submit {
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #2563eb;
  border-radius: 12rpx;
  border: none;
}

.btn-submit[disabled] {
  opacity: 0.5;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #9ca3af;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
