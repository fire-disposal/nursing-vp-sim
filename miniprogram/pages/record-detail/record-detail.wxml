<view class="page">
  <view class="header">训练详情</view>

  <view wx:if="{{record}}" class="content">
    <view class="info-card">
      <text class="info-name">{{record.case_name}}</text>
      <text class="info-time">{{record.start_time}}</text>
      <text class="info-status">{{record.status === 'completed' ? '已完成' : '进行中'}}</text>
    </view>

    <view class="score-section" wx:if="{{record.score}}">
      <view class="score-hero">
        <text class="score-num" style="color: {{scoreGrade.color}}">{{record.score.total_score}}</text>
        <text class="score-grade">{{scoreGrade.label}}</text>
      </view>

      <view class="score-bars" wx:if="{{categoryScores.length > 0}}">
        <view wx:for="{{categoryScores}}" wx:key="name" class="score-bar-item">
          <view class="score-bar-header">
            <text>{{item.name}}</text>
            <text>{{item.score}}/{{item.max}}</text>
          </view>
          <view class="score-bar-track">
            <view class="score-bar-fill" style="width: {{item.max > 0 ? item.score / item.max * 100 : 0}}%; background: {{scoreGrade.color}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="score-section" wx:else>
      <text class="text-secondary">暂无评分</text>
    </view>

    <view class="section" wx:if="{{strengths.length > 0}}">
      <view class="section-title">✓ 优势</view>
      <view wx:for="{{strengths}}" wx:key="*this" class="list-item">
        <text>{{item}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{weaknesses.length > 0}}">
      <view class="section-title">⚠ 待改善</view>
      <view wx:for="{{weaknesses}}" wx:key="*this" class="list-item">
        <text>{{item}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{record.messages && record.messages.length > 0}}">
      <view class="section-title">对话回放</view>
      <view wx:for="{{record.messages}}" wx:key="id" class="replay-msg {{item.role === 'student' ? 'student' : 'patient'}}">
        <text>{{item.content}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">加载中...</view>
</view>
