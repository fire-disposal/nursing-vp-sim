.page { padding: 24rpx; padding-top: 88rpx; padding-bottom: 48rpx; }
.header { font-size: var(--font-xl); font-weight: 700; margin-bottom: 24rpx; }

.info-card {
  background: var(--color-card); border-radius: var(--radius-md); padding: 24rpx;
  box-shadow: var(--shadow-sm); margin-bottom: 24rpx;
}
.info-name { display: block; font-size: var(--font-lg); font-weight: 700; }
.info-time { display: block; font-size: var(--font-xs); color: var(--color-text-tertiary); margin-top: 8rpx; }
.info-status {
  display: inline-block; margin-top: 12rpx; font-size: var(--font-xs); font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 20rpx; background: #eff6ff; color: var(--color-primary);
}

.score-section { margin-bottom: 32rpx; }
.score-hero {
  text-align: center; padding: 40rpx 0; background: var(--color-card); border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm); margin-bottom: 16rpx;
}
.score-num { display: block; font-size: 100rpx; font-weight: 800; }
.score-grade { display: block; font-size: var(--font-sm); color: var(--color-text-secondary); margin-top: 8rpx; }

.score-bars { background: var(--color-card); border-radius: var(--radius-md); padding: 24rpx; box-shadow: var(--shadow-sm); }
.score-bar-item { margin-bottom: 20rpx; }
.score-bar-item:last-child { margin-bottom: 0; }
.score-bar-header { display: flex; justify-content: space-between; font-size: var(--font-xs); margin-bottom: 8rpx; }
.score-bar-track { height: 12rpx; background: #f3f4f6; border-radius: 6rpx; overflow: hidden; }
.score-bar-fill { height: 100%; border-radius: 6rpx; transition: width 0.6s; }

.section { margin-bottom: 24rpx; }
.section-title { font-size: var(--font-sm); font-weight: 600; margin-bottom: 12rpx; }
.list-item {
  font-size: var(--font-xs); color: var(--color-text-secondary); padding: 12rpx 16rpx;
  background: var(--color-card); border-radius: var(--radius-sm); margin-bottom: 8rpx;
}

.replay-msg { font-size: var(--font-sm); padding: 16rpx; border-radius: var(--radius-sm); margin-bottom: 12rpx; line-height: 1.6; }
.replay-msg.patient { background: #f3f4f6; }
.replay-msg.student { background: var(--color-blue-bg); color: var(--color-primary); }

.text-secondary { color: var(--color-text-secondary); font-size: var(--font-sm); }
.empty { text-align: center; padding: 120rpx 0; color: var(--color-text-secondary); }
