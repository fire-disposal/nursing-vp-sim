<view class="page">
  <view class="topbar">
    <view class="back-btn" bindtap="goBack">←</view>
    <view class="patient-info">
      <text class="patient-name">{{patientName}}</text>
      <text class="case-title">{{caseName}}</text>
    </view>
    <view class="timer {{remaining <= 120 ? 'timer-warn' : ''}}">
      <text>⏱ {{timerStr || '--:--'}}</text>
    </view>
    <view class="end-btn" bindtap="handleEnd" wx:if="{{!ending}}">结束</view>
  </view>

  <!-- 系统消息提示 -->
  <view class="system-msg" wx:if="{{systemMsg}}">
    <text>{{systemMsg}}</text>
  </view>

  <scroll-view class="chat-area" scroll-y scroll-into-view="msg-{{messages[messages.length-1].id}}">
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="msg-row {{item.role === 'student' ? 'msg-right' : 'msg-left'}}"
    >
      <view class="msg-bubble {{item.role === 'student' ? 'bubble-student' : 'bubble-patient'}}">
        <text>{{item.content}}</text>
        <text class="streaming-cursor" wx:if="{{item.id === streamingMsgId && sending}}">|</text>
      </view>
    </view>
    <view id="msg-end"></view>
  </scroll-view>

  <!-- 操作面板 -->
  <view class="op-panel {{opPanelOpen ? 'op-panel-open' : ''}}">
    <view class="op-panel-header">
      <text class="op-panel-title">快捷操作</text>
      <view class="op-panel-close" bindtap="toggleOpPanel">✕</view>
    </view>
    <view class="op-panel-grid">
      <view
        class="op-item"
        wx:for="{{['vitals','bp','temp','spo2','hr']}}"
        wx:for-item="key"
        wx:key="*this"
        data-key="{{key}}"
        bindtap="onOpSelect"
      >
        <text class="op-item-icon">{{key === 'vitals' ? '🩺' : key === 'bp' ? '💓' : key === 'temp' ? '🌡' : key === 'spo2' ? '🫁' : '❤️'}}</text>
        <text class="op-item-label">{{key === 'vitals' ? '测体征' : key === 'bp' ? '测血压' : key === 'temp' ? '测体温' : key === 'spo2' ? '血氧' : '心率'}}</text>
      </view>
    </view>
  </view>

  <!-- 操作遮罩 -->
  <view class="op-mask" wx:if="{{opPanelOpen}}" bindtap="toggleOpPanel"></view>

  <view class="input-bar">
    <button class="op-toggle-btn" bindtap="toggleOpPanel">⚡</button>
    <input
      class="chat-input"
      value="{{input}}"
      placeholder="输入消息..."
      bindinput="onInput"
      disabled="{{sending}}"
      confirm-type="send"
      bindconfirm="handleSend"
      maxlength="2000"
    />
    <button class="send-btn" bindtap="handleSend" disabled="{{sending || !input}}">发送</button>
  </view>

  <view class="score-overlay" wx:if="{{showScore && score}}">
    <view class="score-card">
      <text class="score-title">训练评分</text>
      <text class="score-total">{{score.total_score}}</text>
      <text class="score-label">总分</text>
      <!-- 分类得分 -->
      <view class="score-details" wx:if="{{score.detail_scores}}">
        <view class="score-detail-row" wx:for="{{score.detail_scores}}" wx:for-index="k" wx:for-item="v" wx:key="k">
          <view class="score-detail-header">
            <text class="score-detail-name">{{k}}</text>
            <text class="score-detail-value">{{v.score}}/{{v.max}}</text>
          </view>
          <view class="score-detail-bar">
            <view class="score-detail-fill" style="width: {{v.max > 0 ? v.score / v.max * 100 : 0}}%"></view>
          </view>
        </view>
      </view>
      <button class="score-close" bindtap="goBack">返回首页</button>
    </view>
  </view>
</view>
