{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["jest", "node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
