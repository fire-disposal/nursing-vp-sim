{
  "name": "nursing-vp-sim",
  "version": "2026.05.29",
  "private": true,
  "description": "Nursing Virtual Patient Simulator — LLM-powered medical history interview training",
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -n BE,FE -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && .venv\\Scripts\\python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "db:migrate": "cd backend && .venv\\Scripts\\python -m alembic upgrade head",
    "db:migration": "cd backend && .venv\\Scripts\\python -m alembic revision --autogenerate -m",
    "db:downgrade": "cd backend && .venv\\Scripts\\python -m alembic downgrade -1",
    "tag": "node .husky/_/auto-tag.mjs --push",
    "tag:local": "node .husky/_/auto-tag.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "concurrently": "^9",
    "husky": "^9"
  }
}
